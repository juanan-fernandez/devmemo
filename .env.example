# Supabase PostgreSQL — replace with your actual connection string
# For local Supabase: postgresql://postgres:postgres@localhost:54322/postgres
# For hosted Supabase: postgresql://<user>:<password>@<host>:<port>/<database>

# Runtime — pooled connection via PgBouncer (no soporta DDL, óptimo para la app)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# CLI migrations — conexión directa (necesaria para migraciones y DDL)
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Auth.js / NextAuth
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend e-mail api
RESEND_API_KEY=""
EMAIL_FROM="DevMemo <no-reply@example.com>"

# Public app URL used to build e-mail verification links
APP_URL="http://localhost:3000"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Enable e-mail verification for credentials signups and login gating
EMAIL_VERIFICATION=false

# Upstahash API key for rate limiting and abuse prevention
UPSTASH_REDIS_REST_URL="https://capable-condor-93056.upstash.io"
UPSTASH_REDIS_REST_TOKEN="get your own token from https://upstash.com"

# Vercel Blob Storage for file uploads
BLOB_STORE_ID="svercel_blob_store_id"
BLOB_READ_WRITE_TOKEN="vercel_blob_write_token"