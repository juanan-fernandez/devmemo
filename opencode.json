{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"supabase": {
			"type": "remote",
			"url": "https://mcp.supabase.com/mcp",
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@playwright/mcp@latest"
			],
			"enabled": true,
			"timeout": 30000
		}
	}
}